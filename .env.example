# OpenRouter API Key (Khuyên dùng cho bài lab - có model free :free)
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Mistral AI API Key (Tùy chọn - dùng cho embedding hoặc llm)
MISTRAL_API_KEY=replace-with-your-key

# OpenAI API Key (Tùy chọn - fallback nếu OpenRouter bị 429 rate limit)
# OPENAI_API_KEY=sk-proj-...

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=replace-with-your-key

# PageIndex API Key (Tùy chọn - dùng cho Task 8: Vectorless RAG fallback)
# PAGEINDEX_API_KEY=your_pageindex_key_here

# Voyage AI API Key (Khuyến nghị - dùng cho Task 7: Reranking)
# Đăng ký free: https://voyage.ai/ (1M tokens/tháng)
# VOYAGE_API_KEY=voyage-your_key_here

# EMBEDDING_PROVIDER=sentence_transformers  # Mặc định (local, BAAI/bge-m3 1024 dim)
# EMBEDDING_PROVIDER=google                 # Nhẹ, cần GEMINI_API_KEY, dimension 768
# EMBEDDING_PROVIDER=openai                 # Nhẹ, cần OPENAI_API_KEY, dimension 1536
# Lưu ý: đổi provider phải xoá chroma_db/ cũ và chạy lại Task 4
